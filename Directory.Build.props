<Project>

  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <NeutralLanguage>cs-CZ</NeutralLanguage>
    <InvariantGlobalization>false</InvariantGlobalization>
  </PropertyGroup>

  <!--
    Verze. Lokálně zůstává 0.0.0; release workflow ji přepíše hodnotou z gitového tagu
    (dotnet publish -p:Version=1.2.3), takže InformationalVersion sestavené aplikace
    vždy odpovídá tagu, proti kterému kontroluje updater.
  -->
  <PropertyGroup>
    <Version>0.0.0</Version>
    <Company>DarwinKhonus</Company>
    <Product>Plan</Product>
    <Authors>DarwinKhonus</Authors>
  </PropertyGroup>

</Project>
