<Window x:Class="Plan.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Plan.Controls"
        xmlns:vm="clr-namespace:Plan.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="Plan"
        Icon="/Resources/plan.ico"
        Height="640"
        Width="1100"
        MinHeight="420"
        MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="#F7F8FA">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolNaViditelnost" />

        <Style TargetType="Button" x:Key="NastrojovyButton">
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="MinWidth" Value="80" />
        </Style>

        <!--
            Sdílená kontextová nabídka pro časovou osu i tabulku, ať se obojí chová stejně.
            Položky nad zakázkou se samy zakážou, když není nic vybrané (CanExecute příkazů).

            Nabídka nežije ve vizuálním stromu okna, takže by se DataContext dědil
            z prvku, nad kterým se otevřela — u řádku tabulky by to byla ZakazkaViewModel
            a vazby na příkazy by tiše selhaly. Proto se bere z Tagu cílového prvku,
            kam se MainViewModel nastavuje níže.
        -->
        <ContextMenu x:Key="NabidkaZakazky"
                     DataContext="{Binding PlacementTarget.Tag, RelativeSource={RelativeSource Self}}">
            <MenuItem Header="Info" Command="{Binding InfoCommand}" FontWeight="SemiBold" />
            <Separator />
            <MenuItem Header="Upravit zakázku" Command="{Binding UpravitCommand}" InputGestureText="F2" />
            <MenuItem Header="Smazat zakázku" Command="{Binding SmazatCommand}" InputGestureText="Del" />
            <Separator />
            <MenuItem Header="Přidat milník…" Click="Tabulka_PridatMilnik" />
            <MenuItem Header="Upravit milník…" Click="Tabulka_UpravitMilnik">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <!-- Má smysl jen na řádku milníku. -->
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VybranyRadek.JeMilnik}" Value="True">
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <MenuItem Header="Smazat milník" Click="Tabulka_SmazatMilnik">
                <MenuItem.Style>
                    <Style TargetType="MenuItem">
                        <Setter Property="IsEnabled" Value="False" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding VybranyRadek.JeMilnik}" Value="True">
                                <Setter Property="IsEnabled" Value="True" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </MenuItem.Style>
            </MenuItem>
            <Separator />
            <MenuItem Header="Přidat zakázku" Command="{Binding PridatCommand}" InputGestureText="Ctrl+N" />
        </ContextMenu>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="N" Modifiers="Control" Command="{Binding PridatCommand}" />
        <KeyBinding Key="Delete" Command="{Binding SmazatCommand}" />
        <KeyBinding Key="F2" Command="{Binding UpravitCommand}" />
        <KeyBinding Key="F1" Command="{Binding InfoCommand}" />
    </Window.InputBindings>

    <DockPanel>

        <!-- Panel nástrojů -->
        <Border DockPanel.Dock="Top" Background="White" BorderBrush="#E6E9ED" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" Margin="12,10">
                <Button Content="Přidat" Command="{Binding PridatCommand}" Style="{StaticResource NastrojovyButton}" ToolTip="Ctrl+N" />
                <Button Content="Upravit" Command="{Binding UpravitCommand}" Style="{StaticResource NastrojovyButton}" ToolTip="F2" />
                <Button Content="Smazat" Command="{Binding SmazatCommand}" Style="{StaticResource NastrojovyButton}" ToolTip="Delete" />
                <Button Content="Info" Command="{Binding InfoCommand}" Style="{StaticResource NastrojovyButton}" ToolTip="F1" />

                <Separator Margin="8,2" />

                <Button Content="Nastavení" Command="{Binding NastaveniCommand}" Style="{StaticResource NastrojovyButton}" />

                <Separator Margin="8,2" />

                <Button Content="−" Command="{Binding OddalitCommand}" Width="32" MinWidth="32" Padding="0,6" Margin="0,0,4,0" ToolTip="Oddálit časovou osu" />
                <Button Content="+" Command="{Binding PriblizitCommand}" Width="32" MinWidth="32" Padding="0,6" Margin="0,0,6,0" ToolTip="Přiblížit časovou osu" />
                <Button Content="Dnes" Command="{Binding SkocitNaDnesekCommand}" Style="{StaticResource NastrojovyButton}" />
            </StackPanel>
        </Border>

        <!-- Potíž s databází. Nezavírá aplikaci, aby vedle zůstala vidět nabídka aktualizace. -->
        <Border DockPanel.Dock="Top"
                Background="#FDECEA"
                BorderBrush="#F0BFB8"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="{Binding MaChybuDatabaze, Converter={StaticResource BoolNaViditelnost}}">
            <TextBlock Text="{Binding ChybaDatabaze}"
                       TextWrapping="Wrap"
                       Foreground="#922B21" />
        </Border>

        <!-- Notifikace o nové verzi -->
        <Border DockPanel.Dock="Top"
                Background="#FFF6E5"
                BorderBrush="#F0D9A8"
                BorderThickness="0,0,0,1"
                Padding="12,8"
                Visibility="{Binding JeDostupnaAktualizace, Converter={StaticResource BoolNaViditelnost}}">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="{Binding InformaceOAktualizaci}" VerticalAlignment="Center" Foreground="#6B4E11" />

                    <Button Content="Stáhnout a nainstalovat"
                            Command="{Binding StahnoutAktualizaciCommand}"
                            Padding="10,4"
                            Margin="12,0,0,0"
                            Visibility="{Binding LzeStahnoutAktualizaci, Converter={StaticResource BoolNaViditelnost}}" />

                    <!-- Záloha pro případ, že release instalátor neobsahuje nebo stahování selže. -->
                    <TextBlock Margin="12,0,0,0" VerticalAlignment="Center">
                        <Hyperlink NavigateUri="{Binding UrlAktualizace}" RequestNavigate="Hyperlink_RequestNavigate">
                            Otevřít stránku ke stažení
                        </Hyperlink>
                    </TextBlock>
                </StackPanel>

                <StackPanel Orientation="Horizontal"
                            Margin="0,8,0,0"
                            Visibility="{Binding StahujeSe, Converter={StaticResource BoolNaViditelnost}}">
                    <!-- ProgressBar.Value se váže TwoWay by default, což na vlastnosti
                         s privátním setterem skončí výjimkou. -->
                    <ProgressBar Value="{Binding PokrokStahovani, Mode=OneWay}"
                                 Maximum="100"
                                 Width="260"
                                 Height="6"
                                 VerticalAlignment="Center" />
                    <TextBlock Text="{Binding PokrokStahovani, StringFormat={}{0:0} %}"
                               VerticalAlignment="Center"
                               Margin="8,0,0,0"
                               Foreground="#6B4E11" />
                </StackPanel>

                <TextBlock Text="{Binding StavStahovani}"
                           Foreground="#6B4E11"
                           TextWrapping="Wrap"
                           Margin="0,6,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Visible" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StavStahovani}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- Stavový řádek -->
        <Border DockPanel.Dock="Bottom" Background="White" BorderBrush="#E6E9ED" BorderThickness="0,1,0,0" Padding="12,6">
            <Grid>
                <TextBlock Text="{Binding SouhrnStavu}" Foreground="#4A5563" />
                <TextBlock x:Name="VerzeText" HorizontalAlignment="Right" Foreground="#98A1AF" />
            </Grid>
        </Border>

        <TabControl Margin="12" BorderThickness="1" BorderBrush="#E1E5EA" Background="White">

            <TabItem Header="Časová osa">
                <Grid>
                    <ScrollViewer x:Name="OsaScroll"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto"
                                  ScrollChanged="OsaScroll_ScrollChanged"
                                  PreviewMouseWheel="OsaScroll_PreviewMouseWheel">
                        <controls:CasovaOsa x:Name="Osa"
                                            ContextMenuOpening="Osa_ContextMenuOpening"
                                            Zakazky="{Binding Zakazky}"
                                            Kalendar="{Binding Kalendar}"
                                            VybranaZakazka="{Binding VybranaZakazka, Mode=TwoWay}"
                                            PrvniDen="{Binding PrvniDen}"
                                            PocetDnu="{Binding PocetDnu}"
                                            SirkaDne="{Binding SirkaDne}"
                                            SirkaViditelnehoOkna="{Binding SirkaViditelneCasti}"
                                            UsekZmenen="Osa_UsekZmenen"
                                            MilnikKliknut="Osa_MilnikKliknut"
                                            LzeMenitPoradi="{Binding LzeMenitPoradi}"
                                            PoradiZmeneno="Osa_PoradiZmeneno"
                                            PoradiDotazeno="Osa_PoradiDotazeno">
                            <controls:CasovaOsa.ContextMenu>
                                <!--
                                    Vlastní nabídka osy: položky pro úseky a milníky potřebují
                                    vědět, na který den a úsek se kliklo, což tabulka nemá.
                                    Obsluha je proto v code-behind, ne přes příkazy ViewModelu.
                                -->
                                <ContextMenu>
                                    <MenuItem Header="Info" FontWeight="SemiBold" Click="Nabidka_Info" />
                                    <Separator />
                                    <MenuItem x:Name="PolozkaRozdelit" Header="Rozdělit zde" Click="Nabidka_RozdelitZde" />
                                    <MenuItem x:Name="PolozkaOdstranitUsek" Header="Odstranit tento úsek" Click="Nabidka_OdstranitUsek" />
                                    <Separator />
                                    <MenuItem x:Name="PolozkaPridatMilnik" Header="Přidat milník zde…" Click="Nabidka_PridatMilnik" />
                                    <MenuItem x:Name="PolozkaOdebratMilnik" Header="Odebrat milník" Click="Nabidka_OdebratMilnik" />
                                    <Separator />
                                    <MenuItem x:Name="PolozkaUpravit" Header="Upravit" InputGestureText="F2" Click="Nabidka_Upravit" />
                                    <MenuItem x:Name="PolozkaSmazat" Header="Smazat" InputGestureText="Del" Click="Nabidka_Smazat" />
                                    <Separator />
                                    <MenuItem Header="Přidat zakázku" InputGestureText="Ctrl+N" Click="Nabidka_PridatZakazku" />
                                </ContextMenu>
                            </controls:CasovaOsa.ContextMenu>
                        </controls:CasovaOsa>
                    </ScrollViewer>

                    <TextBlock Text="Zatím žádné zakázky. Přidejte první tlačítkem Přidat."
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               Foreground="#98A1AF"
                               IsHitTestVisible="False">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Zakazky.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
            </TabItem>

            <TabItem Header="Tabulka">
                <DataGrid ItemsSource="{Binding RadkyTabulky}"
                          SelectedItem="{Binding VybranyRadek, Mode=TwoWay}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#EDEFF2"
                          BorderThickness="0"
                          RowHeight="30"
                          MouseDoubleClick="Tabulka_MouseDoubleClick"
                          PreviewMouseRightButtonDown="Tabulka_PreviewMouseRightButtonDown"
                          PreviewKeyDown="Tabulka_PreviewKeyDown">

                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <!-- Nabídka na řádku, ne na celém gridu: pravý klik tak rovnou
                                 přenese výběr na zakázku pod kurzorem. -->
                            <Setter Property="ContextMenu" Value="{StaticResource NabidkaZakazky}" />
                            <Setter Property="Tag"
                                    Value="{Binding DataContext, RelativeSource={RelativeSource AncestorType=Window}}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MaKolizi}" Value="True">
                                    <Setter Property="Background" Value="#FDECEA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.RowStyle>

                    <DataGrid.Columns>
                        <!-- Název: u milníku odsazený a se spojnicí, aby tabulka čitelně
                             naznačila strom. -->
                        <DataGridTemplateColumn Header="Název" Width="*">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <StackPanel.Style>
                                            <Style TargetType="StackPanel">
                                                <Style.Triggers>
                                                    <!-- Odsazení milníku pod jeho zakázku. -->
                                                    <DataTrigger Binding="{Binding JeMilnik}" Value="True">
                                                        <Setter Property="Margin" Value="18,0,0,0" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </StackPanel.Style>

                                        <!-- Přepínač stromu milníků. Místo si drží i zakázka
                                             bez milníků, aby názvy zůstaly zarovnané. -->
                                        <Button Width="16"
                                                Height="16"
                                                Padding="0"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Background="#F2F4F7"
                                                BorderBrush="#C7CDD5"
                                                BorderThickness="1"
                                                ToolTip="{Binding PopisPrepinace}"
                                                Click="Tabulka_PrepnoutRozbaleni">
                                            <!--
                                                Znaménko se kreslí, ne píše. Jako text „+“ a „−“
                                                sedělo kvůli metrikám písma pod středem čtverečku;
                                                obdélníky se vystředí přesně.
                                            -->
                                            <!--
                                                Rozměry jsou celá čísla a středění tak padne
                                                na celé pixely. S 1,5 px se svislá čárka
                                                rozmazávala do dvou pixelů a vedle vodorovné
                                                vypadala nepatřičně.
                                            -->
                                            <Grid Width="8" Height="8" UseLayoutRounding="True">
                                                <Rectangle Width="8"
                                                           Height="2"
                                                           Fill="#3C4653"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center" />
                                                <Rectangle Width="2"
                                                           Height="8"
                                                           Fill="#3C4653"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center">
                                                    <Rectangle.Style>
                                                        <Style TargetType="Rectangle">
                                                            <!-- Svislá čárka jen u sbaleného: dává plus. -->
                                                            <Setter Property="Visibility" Value="Visible" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding JeRozbalena}" Value="True">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </Rectangle.Style>
                                                </Rectangle>
                                            </Grid>

                                            <Button.Style>
                                                <Style TargetType="Button">
                                                    <Setter Property="Visibility" Value="Hidden" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding LzeRozbalit}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Button.Style>
                                        </Button>

                                        <TextBlock Text="{Binding Spojnice}"
                                                   Foreground="#A9B2BE"
                                                   FontFamily="Consolas" />
                                        <TextBlock Text="{Binding Nazev}" Margin="4,0,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding JeMilnik}" Value="True">
                                                            <Setter Property="Foreground" Value="#8A6100" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>

                        <DataGridTextColumn Header="Termín od" Binding="{Binding TerminOd}" Width="110" />
                        <DataGridTextColumn Header="Termín do" Binding="{Binding TerminDo}" Width="110" />
                        <DataGridTextColumn Header="Dnů" Binding="{Binding Dnu}" Width="60" />
                        <DataGridTextColumn Header="Úseků" Binding="{Binding Useku}" Width="60" />
                        <DataGridTextColumn Header="Pracovních dnů" Binding="{Binding PracovnichDnu}" Width="110" />
                        <DataGridTextColumn Header="Odhad hodin" Binding="{Binding Hodiny}" Width="100" />

                        <DataGridTemplateColumn Header="Stav" Width="100">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="9"
                                            Padding="8,2"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Visibility="{Binding ZobrazitStav, Converter={StaticResource BoolNaViditelnost}}">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Background" Value="#E3F3E8" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding MaKolizi}" Value="True">
                                                        <Setter Property="Background" Value="#F8D7D3" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Stav}" FontSize="11">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="#1E6B3A" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding MaKolizi}" Value="True">
                                                            <Setter Property="Foreground" Value="#922B21" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                </DataGrid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
