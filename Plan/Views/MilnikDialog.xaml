<Window x:Class="Plan.Views.MilnikDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Nový milník"
        Icon="/Resources/plan.ico"
        Width="380"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NazevBox}">

    <StackPanel Margin="18">
        <TextBlock x:Name="DatumText"
                   Foreground="#8A94A3"
                   Margin="0,0,0,12" />

        <TextBlock Text="Název milníku" Foreground="#4A5563" Margin="0,0,0,4" />
        <TextBox x:Name="NazevBox"
                 Padding="6,5"
                 TextChanged="NazevBox_TextChanged" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Zrušit" MinWidth="88" Padding="10,6" IsCancel="True" Margin="0,0,8,0" />
            <Button x:Name="UlozitButton"
                    Content="Přidat"
                    MinWidth="88"
                    Padding="10,6"
                    IsDefault="True"
                    IsEnabled="False"
                    Click="Ulozit_Click" />
        </StackPanel>
    </StackPanel>
</Window>
