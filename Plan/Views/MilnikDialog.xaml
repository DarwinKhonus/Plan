<Window x:Class="Plan.Views.MilnikDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Name="Okno"
        Title="Milník"
        Icon="/Resources/plan.ico"
        Width="400"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        FocusManager.FocusedElement="{Binding ElementName=NazevBox}">

    <StackPanel Margin="18">
        <TextBlock x:Name="ZakazkaText"
                   Foreground="#8A94A3"
                   TextWrapping="Wrap"
                   Margin="0,0,0,14" />

        <TextBlock Text="Název milníku" Foreground="#4A5563" Margin="0,0,0,4" />
        <TextBox x:Name="NazevBox"
                 Padding="6,5"
                 Margin="0,0,0,14"
                 TextChanged="Vstup_Zmenen" />

        <TextBlock Text="Datum" Foreground="#4A5563" Margin="0,0,0,4" />
        <DatePicker x:Name="DatumPicker"
                    SelectedDateChanged="Datum_Zmeneno" />

        <Grid Margin="0,20,0,0">
            <Button x:Name="SmazatButton"
                    Content="Smazat milník"
                    HorizontalAlignment="Left"
                    Padding="10,6"
                    Foreground="#922B21"
                    Click="Smazat_Click"
                    Visibility="Collapsed" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Zrušit" MinWidth="88" Padding="10,6" IsCancel="True" Margin="0,0,8,0" />
                <Button x:Name="UlozitButton"
                        Content="Uložit"
                        MinWidth="88"
                        Padding="10,6"
                        IsDefault="True"
                        IsEnabled="False"
                        Click="Ulozit_Click" />
            </StackPanel>
        </Grid>
    </StackPanel>
</Window>
