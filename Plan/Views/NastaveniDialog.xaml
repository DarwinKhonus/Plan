<Window x:Class="Plan.Views.NastaveniDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Plan.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:NastaveniViewModel}"
        Title="Nastavení pracovní doby"
        Icon="/Resources/plan.ico"
        Width="440"
        SizeToContent="Height"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <Style TargetType="TextBlock" x:Key="Nadpis">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#2C3542" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style TargetType="CheckBox" x:Key="DenTydne">
            <Setter Property="Margin" Value="0,0,14,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <StackPanel Margin="18">
        <TextBlock Text="Pracovní dny v týdnu" Style="{StaticResource Nadpis}" />
        <WrapPanel Margin="0,0,0,18">
            <CheckBox Content="Po" IsChecked="{Binding Pondeli}" Style="{StaticResource DenTydne}" />
            <CheckBox Content="Út" IsChecked="{Binding Utery}" Style="{StaticResource DenTydne}" />
            <CheckBox Content="St" IsChecked="{Binding Streda}" Style="{StaticResource DenTydne}" />
            <CheckBox Content="Čt" IsChecked="{Binding Ctvrtek}" Style="{StaticResource DenTydne}" />
            <CheckBox Content="Pá" IsChecked="{Binding Patek}" Style="{StaticResource DenTydne}" />
            <CheckBox Content="So" IsChecked="{Binding Sobota}" Style="{StaticResource DenTydne}" />
            <CheckBox Content="Ne" IsChecked="{Binding Nedele}" Style="{StaticResource DenTydne}" />
        </WrapPanel>

        <TextBlock Text="Pracovní doba" Style="{StaticResource Nadpis}" />
        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
            <TextBlock Text="od" VerticalAlignment="Center" Margin="0,0,6,0" Foreground="#4A5563" />
            <TextBox Width="70"
                     Padding="6,5"
                     Text="{Binding ZacatekPrace, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            <TextBlock Text="do" VerticalAlignment="Center" Margin="12,0,6,0" Foreground="#4A5563" />
            <TextBox Width="70"
                     Padding="6,5"
                     Text="{Binding KonecPrace, UpdateSourceTrigger=PropertyChanged, ValidatesOnDataErrors=True}" />
            <TextBlock Text="{Binding HodinDenneText}"
                       VerticalAlignment="Center"
                       Margin="14,0,0,0"
                       FontWeight="SemiBold"
                       Foreground="#2C6494" />
        </StackPanel>
        <TextBlock Text="Zadávejte ve tvaru HH:mm, například 08:00."
                   Foreground="#8A94A3"
                   FontSize="11"
                   Margin="0,0,0,18" />

        <CheckBox Content="Považovat české státní svátky za nepracovní dny"
                  IsChecked="{Binding ZohlednitSvatky}"
                  Margin="0,0,0,6" />
        <TextBlock Text="Svátky se počítají automaticky pro každý rok včetně pohyblivých Velikonoc."
                   Foreground="#8A94A3"
                   FontSize="11"
                   TextWrapping="Wrap"
                   Margin="0,0,0,18" />

        <TextBlock Text="Vyberte aspoň jeden pracovní den a platný rozsah pracovní doby."
                   Foreground="#C0392B"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Setter Property="Visibility" Value="Visible" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding JePlatny}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Zrušit" MinWidth="88" Padding="10,6" IsCancel="True" Margin="0,0,8,0" />
            <Button Content="Uložit"
                    MinWidth="88"
                    Padding="10,6"
                    IsDefault="True"
                    Click="Ulozit_Click"
                    IsEnabled="{Binding JePlatny}" />
        </StackPanel>
    </StackPanel>
</Window>
