<Window x:Class="Plan.Views.InfoDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:Plan.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:InfoViewModel}"
        Title="Info o zakázce"
        Icon="/Resources/plan.ico"
        Width="440"
        SizeToContent="Height"
        MaxHeight="700"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolNaViditelnost" />
    </Window.Resources>

    <StackPanel Margin="18">

        <TextBlock Text="{Binding Nazev}"
                   FontSize="16"
                   FontWeight="SemiBold"
                   Foreground="#2C3542"
                   TextWrapping="Wrap"
                   Margin="0,0,0,4" />

        <Border CornerRadius="9"
                Padding="9,3"
                HorizontalAlignment="Left"
                Margin="0,0,0,16">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Background" Value="#E3F3E8" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding MaKolizi}" Value="True">
                            <Setter Property="Background" Value="#F8D7D3" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <TextBlock Text="{Binding Stav}" FontSize="11">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#1E6B3A" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MaKolizi}" Value="True">
                                <Setter Property="Foreground" Value="#922B21" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </Border>

        <!-- Přehled údajů. Nové položky stačí přidat do InfoViewModel.Radky. -->
        <ItemsControl ItemsSource="{Binding Radky}">
            <ItemsControl.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="0,0,0,7">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="140" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="{Binding Popisek}"
                                   Foreground="#8A94A3"
                                   VerticalAlignment="Top" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Hodnota}"
                                   Foreground="#2C3542"
                                   TextWrapping="Wrap" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Rozpis úseků, jen u rozdělené zakázky -->
        <StackPanel Visibility="{Binding MaSeznamUseku, Converter={StaticResource BoolNaViditelnost}}">
            <Separator Margin="0,10,0,12" />
            <TextBlock Text="Úseky" Foreground="#8A94A3" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Useky}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#2C3542" Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Milníky, jen když nějaké jsou -->
        <StackPanel Visibility="{Binding MaSeznamMilniku, Converter={StaticResource BoolNaViditelnost}}">
            <Separator Margin="0,10,0,12" />
            <TextBlock Text="Milníky" Foreground="#8A94A3" Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding Milniky}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" Foreground="#8A6100" Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- Seznam kolidujících zakázek, jen když nějaké jsou -->
        <StackPanel Visibility="{Binding MaSeznamKolizi, Converter={StaticResource BoolNaViditelnost}}">
            <Separator Margin="0,10,0,12" />
            <TextBlock Text="Koliduje s"
                       Foreground="#8A94A3"
                       Margin="0,0,0,6" />
            <ItemsControl ItemsSource="{Binding KolidujiciZakazky}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding}"
                                   Foreground="#922B21"
                                   TextWrapping="Wrap"
                                   Margin="0,0,0,4" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <Button Content="Zavřít"
                MinWidth="88"
                Padding="10,6"
                HorizontalAlignment="Right"
                Margin="0,18,0,0"
                IsDefault="True"
                IsCancel="True" />
    </StackPanel>
</Window>
